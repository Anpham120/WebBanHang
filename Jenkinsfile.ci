// WebBanHang CI on a Linux Jenkins node: Checkout -> Restore -> Build -> Test -> Publish.
// Quick CI-only pipeline: it does not deploy, because IIS only exists on Windows. The full CI/CD
// pipeline (Deploy to IIS and Verify on a Windows agent) is in the Jenkinsfile.
// The node needs git and the .NET 8 SDK:  sudo apt-get install -y git dotnet-sdk-8.0
pipeline {
    agent { label '!windows' } // any node that is not the Windows agent, including the built-in node

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch to build.')
    }

    triggers {
        githubPush() // GitHub webhook -> https://<jenkins>/github-webhook/
    }

    options {
        skipDefaultCheckout(true) // the Checkout stage below clones the requested branch
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '3'))
    }

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = '1'
        MSBUILDDISABLENODEREUSE = '1' // do not leave MSBuild worker processes behind on a small VPS
        APP_VERSION = "1.0.${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def branch = params.BRANCH ?: 'main'
                    def scmVars = checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${branch}"]],
                        userRemoteConfigs: scm.userRemoteConfigs
                    ])
                    echo "Branch ${branch} at commit ${scmVars.GIT_COMMIT}"
                }
            }
        }

        stage('Restore') {
            steps {
                sh 'rm -rf test-results publish WebBanHang-*.tar.gz'
                sh 'dotnet --version'
                sh 'dotnet restore WebBanHang.sln'
            }
        }

        stage('Build') {
            steps {
                sh 'dotnet build WebBanHang.sln -c Release --no-restore -p:Version=$APP_VERSION -p:UseSharedCompilation=false'
            }
        }

        stage('Test') {
            steps {
                sh 'dotnet test WebBanHang.sln -c Release --no-build --logger "junit;LogFilePath=$WORKSPACE/test-results/results.xml"'
            }
            post {
                always {
                    junit 'test-results/*.xml'
                }
            }
        }

        stage('Publish') {
            steps {
                sh 'dotnet publish src/WebBanHang/WebBanHang.csproj -c Release --no-build -o publish -p:Version=$APP_VERSION'
                sh 'tar -czf WebBanHang-$APP_VERSION.tar.gz -C publish .'
                archiveArtifacts artifacts: 'WebBanHang-*.tar.gz'
            }
        }
    }

    post {
        success {
            echo "Build ${env.BUILD_NUMBER} succeeded: WebBanHang-${env.APP_VERSION}.tar.gz is attached to the build."
        }
        failure {
            echo 'Pipeline failed: the stages after the failing one were not run.'
        }
    }
}
