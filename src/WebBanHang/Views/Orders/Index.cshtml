@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Đơn hàng</h1>
    <a class="btn btn-primary" asp-action="Create">Tạo đơn hàng</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Mã</th>
            <th>@Html.DisplayNameFor(m => m.CustomerName)</th>
            <th>@Html.DisplayNameFor(m => m.OrderDate)</th>
            <th class="text-end">Số mặt hàng</th>
            <th class="text-end">@Html.DisplayNameFor(m => m.Total)</th>
            <th>@Html.DisplayNameFor(m => m.Status)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.CustomerName</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end">@order.Items.Sum(i => i.Quantity)</td>
                <td class="text-end">@order.Total.ToVnd()</td>
                <td>@Html.DisplayFor(m => order.Status)</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>
