@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sản phẩm</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo tên sản phẩm" />
    </div>
    <div class="col-md-4">
        <select name="categoryId" class="form-select" asp-items="(SelectList)ViewBag.Categories">
            <option value="">Tất cả danh mục</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary">Lọc</button>
        <a class="btn btn-link" asp-action="Index">Xóa lọc</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Category)</th>
            <th class="text-end">@Html.DisplayNameFor(m => m.Price)</th>
            <th class="text-end">@Html.DisplayNameFor(m => m.Stock)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td class="text-end">@product.Price.ToVnd()</td>
                <td class="text-end">@product.Stock</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
