@model IEnumerable<Category>
@{
    ViewData["Title"] = "Danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Danh mục sản phẩm</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm danh mục</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Description)</th>
            <th class="text-end">Số sản phẩm</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td class="text-end">@category.Products.Count</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
